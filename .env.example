# Copy to .env and fill in the values:  cp .env.example .env
# Values can also be passed at build time with --dart-define=KEY=value
# (a --dart-define value takes priority over .env).

# URLs (defaults shown; safe to leave as-is for production)
SITE_URL=https://www.owrite.id
API_BASE_URL=https://cms.owrite.id/wp-json/wp/v2
# Comma-separated, tried in order
OPEN_VOICE_API_URLS=https://sinpo.id/api/tts,https://www.sinpo.id/api/tts

# Google API keys
GOOGLE_TTS_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# EmailJS (feedback form)
EMAILJS_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
FEEDBACK_TARGET_EMAIL=
